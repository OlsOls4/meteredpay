 "segments": [
  {
   "start": 0.0,
   "end": 4.5,
   "text": "Second, good check. Checked the same way. That's point two spent."
  },
  {
   "start": 5.28,
   "end": 10.64,
   "text": "The limit reached one more call and the contract says no before any money moves."
  },
  {
   "start": 11.56,
   "end": 19.08,
   "text": "Overbudget. Refused. On the record. Balance untouched. One honest limit. This protects the buyer."
  },
  {
   "start": 19.56,
   "end": 24.96,
   "text": "Not the seller. A dishonest buyer could still claim a failure. The buyer checks every receipt."
  },
  {
   "start": 24.96,
   "end": 27.68,
   "text": "The contract only pays on one the buyer has signed."
  },
  {
   "start": 28.96,
   "end": 33.2,
   "text": "Meeted pay. Failed call. Deducted. Zero."
  }
 ],
