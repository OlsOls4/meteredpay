 "segments": [
  {
   "start": 0.0,
   "end": 3.14,
   "text": "Second good check, checked the same way."
  },
  {
   "start": 3.42,
   "end": 8.1,
   "text": "That's point two spent, the limit reached one more call,"
  },
  {
   "start": 8.46,
   "end": 10.9,
   "text": "and the contract says no before any money moves."
  },
  {
   "start": 11.54,
   "end": 16.08,
   "text": "Overbudget, refused, on the record, balance untouched."
  },
  {
   "start": 16.94,
   "end": 20.74,
   "text": "One honest limit, this protects the buyer, not the seller."
  },
  {
   "start": 21.58,
   "end": 23.58,
   "text": "A dishonest buyer could still claim a failure,"
  },
  {
   "start": 24.1,
   "end": 28.7,
   "text": "the buyer checks every receipt, the contract only pays on one the buyer has signed."
  },
  {
   "start": 28.7,
   "end": 34.24,
   "text": "Meeted pay, failed call, deducted, zero."
  }
 ],
