 "segments": [
  {
   "start": 0.0,
   "end": 6.8,
   "text": "Second, good check. Checked, the same way, that's point two spent, the limit reached."
  },
  {
   "start": 7.58,
   "end": 16.48,
   "text": "One more call, and the contract says no before any money moves. Overbudget. Refused. On the record. Balance untouched."
  },
  {
   "start": 17.56,
   "end": 24.14,
   "text": "One honest limit. This protects the buyer, not the seller. A dishonest buyer could still claim a failure."
  },
  {
   "start": 24.14,
   "end": 29.2,
   "text": "The buyer checks every receipt. The contract only pays on one the buyer has signed."
  },
  {
   "start": 29.84,
   "end": 34.02,
   "text": "Meeted pay, failed call, deducted, zero."
  }
 ],
