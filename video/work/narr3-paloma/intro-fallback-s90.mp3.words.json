  {
   "start": 0.0,
   "end": 3.12,
   "text": "This is Meeted Pay on Tessnet,"
  },
  {
   "start": 3.68,
   "end": 7.24,
   "text": "agents pay for every call, even the ones that fail."
  },
  {
   "start": 8.0,
   "end": 11.86,
   "text": "Say 1 in 10 fails, that's money for work that never happened."
  },
  {
   "start": 12.84,
   "end": 15.82,
   "text": "Meeted Pay only pays when the work checks out."
  },
  {
   "start": 16.14,
   "end": 16.94,
   "text": "Watch what happens."
  }
 ],
