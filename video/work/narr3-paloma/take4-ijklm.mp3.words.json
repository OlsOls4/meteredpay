 "segments": [
  {
   "start": 0.0,
   "end": 5.92,
   "text": "Second good check, checked. The same way that's point two spent, the limit reached."
  },
  {
   "start": 7.08,
   "end": 11.12,
   "text": "One more call, and the contract says no before any money moves."
  },
  {
   "start": 12.06,
   "end": 14.18,
   "text": "Overbudget refused on the record."
  },
  {
   "start": 15.34,
   "end": 20.36,
   "text": "Balance untouched, one honest limit. This protects the buyer not the seller."
  },
  {
   "start": 20.92,
   "end": 25.42,
   "text": "A dishonest buyer could still claim a failure. The buyer checks every receipt."
  },
  {
   "start": 26.14,
   "end": 28.66,
   "text": "The contract only pays on one the buyer has signed."
  },
  {
   "start": 28.66,
   "end": 34.04,
   "text": "Meet a pay, failed call, deducted zero."
  }
 ],
