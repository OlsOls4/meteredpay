  {
   "start": 0.0,
   "end": 3.98,
   "text": "Second good check, checked, the same way that's point two spent."
  },
  {
   "start": 4.6,
   "end": 9.38,
   "text": "The limit reached, one more call and the contract says no before any money moves."
  },
  {
   "start": 10.2,
   "end": 16.56,
   "text": "Over budget refused. On the record, one honest limit, this protects the buyer not the seller."
  },
  {
   "start": 17.28,
   "end": 21.72,
   "text": "A dishonest buyer could still claim a failure. The buyer checks every receipt."
  },
  {
   "start": 22.22,
   "end": 24.68,
   "text": "The contract only pays on one the buyer has signed."
  },
  {
   "start": 24.68,
   "end": 30.16,
   "text": "Meeted pay failed call, deducted zero."
  }
