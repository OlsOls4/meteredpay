  "intro-s100.mp3": [
   {
    "text": "This is MeteredPay, on testnet.",
    "start": 0.0,
    "end": 2.42
   },
   {
    "text": "Agents pay for every call \u2014 even the ones that fail.",
    "start": 2.68,
    "end": 5.82
   },
   {
    "text": "Say one in ten fails: that's money paid for work that never happened.",
    "start": 5.9,
    "end": 9.16
   },
   {
    "text": "MeteredPay only pays when the work checks out.",
    "start": 9.64,
    "end": 12.06
   },
   {
    "text": "Watch what happens when a call fails.",
    "start": 12.4,
    "end": 13.96
   }
  ],
