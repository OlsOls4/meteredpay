  {
   "start": 0.0,
   "end": 6.2,
   "text": "This is meated pay on test net, agents pay for every call, even the ones that fail."
  },
  {
   "start": 6.82,
   "end": 10.58,
   "text": "Say one in ten fails, that's money for work that never happened."
  },
  {
   "start": 11.42,
   "end": 14.44,
   "text": "Meated pay only pays when the work checks out."
  },
  {
   "start": 14.86,
   "end": 15.66,
   "text": "Watch what happens."
  }
 ],
