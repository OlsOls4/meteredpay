  "intro-fallback-s92.mp3": [
   {
    "text": "This is MeteredPay, on testnet.",
    "start": 0.0,
    "end": 2.64
   },
   {
    "text": "Agents pay for every call — even the ones that fail.",
    "start": 2.98,
    "end": 6.2
   },
   {
    "text": "Say one in ten fails: that's money for work that never happened.",
    "start": 6.82,
    "end": 10.58
   },
   {
    "text": "MeteredPay only pays when the work checks out.",
    "start": 11.42,
    "end": 14.44
   },
   {
    "text": "Watch what happens.",
    "start": 14.86,
    "end": 15.66
   }
