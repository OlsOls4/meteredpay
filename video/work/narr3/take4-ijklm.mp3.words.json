 "segments": [
  {
   "start": 0.0,
   "end": 6.86,
   "text": "Second good check. Checked. The same way that's point two spent. The limit reached."
  },
  {
   "start": 7.86,
   "end": 14.84,
   "text": "One more call and the contract says no before any money moves. Overbudget refused on the record."
  },
  {
   "start": 15.74,
   "end": 21.02,
   "text": "Balance untouched. One on his limit. This protects the buyer. Not the seller."
  },
  {
   "start": 21.68,
   "end": 26.02,
   "text": "A dishonest buyer could still claim a failure. The buyer checks every receipt."
  },
  {
   "start": 26.02,
   "end": 29.06,
   "text": "The contract only pays on one the buyer has signed."
  },
  {
   "start": 29.86,
   "end": 33.8,
   "text": "Meet a pay. Fail call, deducted. Zero."
  }
 ],
